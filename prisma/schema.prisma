// Yilow.ai Database Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════
// AUTH (NextAuth v5 + Credentials)
// ════════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?   // bcrypt — null for OAuth-only users

  // Access control
  role           UserRole  @default(USER)
  isBanned       Boolean   @default(false)
  bannedReason   String?
  bannedAt       DateTime?

  // Plan & credits
  plan           Plan      @default(FREE)
  creditsBalance Int       @default(100)   // seed bonus
  creditsLimit   Int       @default(100)   // plan monthly allowance
  planRenewsAt   DateTime?

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  generations        Generation[]
  chatConversations  ChatConversation[]
  spaces             Space[]
  agentSubscriptions AgentSubscription[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]
  payments           Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]    @relation("ActorLogs")
  referralsGiven     Referral[]    @relation("Referrer")
  referralsReceived  Referral[]    @relation("Referee")
  referralCode       String?       @unique
  soulMoodboards     SoulMoodboard[]
  soulCharacters     SoulCharacter[]
  userVoices         UserVoice[]
  apiKeys            ApiKey[]
  ownedTeams         Team[]              @relation("TeamOwner")
  teamMemberships    TeamMember[]
  folders            Folder[]
  products           Product[]
  adReferences       AdReference[]
}

enum Plan {
  FREE
  // Solo / personal tiers
  STARTER       // $15
  BASIC         // $9  — legacy name kept for backward compatibility
  LITE          // $19
  PRO           // $29
  PLUS          // $49
  CREATOR       // $79
  ULTIMATE      // $99
  ULTRA         // $129
  // Org tiers
  TEAM
  ENTERPRISE
}

enum UserRole {
  USER
  ADMIN         // can manage users, view analytics
  SUPER_ADMIN   // everything ADMIN can do + grant/revoke admin roles
}

// OAuth linked accounts (Google/GitHub)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ════════════════════════════════════════════════════════════════
// CREDITS
// ════════════════════════════════════════════════════════════════

model CreditTransaction {
  id        String          @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Int             // negative for deductions, positive for purchases/bonuses
  balanceAfter Int
  reason    String?         // tool id, purchase id, etc.
  metadata  Json?           // { toolId, toolName, generationId, stripePaymentId }
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum TransactionType {
  DEDUCTION       // tool usage
  PURCHASE        // bought credits pack
  SUBSCRIPTION    // monthly plan renewal bonus
  BONUS           // signup gift, referral
  REFUND          // failed generation
  ADJUSTMENT      // admin adjustment
}

// ════════════════════════════════════════════════════════════════
// GENERATIONS (tool outputs history)
// ════════════════════════════════════════════════════════════════

model Generation {
  id          String            @id @default(cuid())
  userId      String
  toolId      String            // matches src/lib/data/tools.ts id
  toolName    String            // cached for display
  category    String            // "image" | "video" | "audio"
  status      GenerationStatus  @default(PENDING)
  creditsUsed Int

  inputs      Json              // form inputs object
  outputs     Json?             // MuAPI response (urls, text, etc.)
  prompt      String?           // cached for search / display (extracted from inputs)
  errorMessage String?

  muapiJobId  String?           // for polling long-running jobs
  durationMs  Int?

  // ── Organization ─────────────────────────────────────────────
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // ── Social ───────────────────────────────────────────────────
  liked       Boolean  @default(false)
  likeCount   Int      @default(0)
  isPublic    Boolean  @default(false)
  isFeatured  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, liked])
  @@index([userId, folderId])
  @@index([toolId])
  @@index([isPublic, createdAt])
  @@index([isFeatured, createdAt])
}

model Folder {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?  // hex (#xxxxxx) for the chip in the picker
  parentId    String?
  parent      Folder?  @relation("FolderParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[] @relation("FolderParent")
  generations Generation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, parentId])
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NSFW           // model flagged the output as NSFW — auto-refunded
  IP_DETECTED    // potential trademark / IP match — auto-refunded
}

// ════════════════════════════════════════════════════════════════
// CHAT
// ════════════════════════════════════════════════════════════════

model ChatConversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("محادثة جديدة")
  model     String    // "claude-3-5-sonnet" | "gpt-4o" | "gemini-1.5-pro" | "llama-3"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String           @db.Text
  attachments    Json?            // array of file refs
  metadata       Json?            // tokens, model-specific, etc.
  createdAt      DateTime         @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// ════════════════════════════════════════════════════════════════
// SPACES (collaboration canvas)
// ════════════════════════════════════════════════════════════════

model Space {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("مساحة جديدة")
  description String?
  thumbnail   String?  // auto-generated preview

  // @xyflow/react state
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  viewport    Json?    // { x, y, zoom }

  // sharing
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastOpenedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ════════════════════════════════════════════════════════════════
// AGENT SUBSCRIPTIONS (marketplace)
// ════════════════════════════════════════════════════════════════

model AgentSubscription {
  id              String              @id @default(cuid())
  userId          String
  agentId         String              // matches src/lib/data/agents.ts id
  agentName       String              // cached
  monthlyPriceUsd Decimal             @db.Decimal(10, 2)
  status          SubscriptionStatus  @default(ACTIVE)

  stripeSubscriptionId String? @unique

  startedAt   DateTime  @default(now())
  renewalDate DateTime?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

// ════════════════════════════════════════════════════════════════
// BILLING — Stripe-backed subscriptions, one-off payments, credit packs
// ════════════════════════════════════════════════════════════════

// One row per Stripe subscription. The "current" subscription for a user
// is also denormalised on User.stripeSubscriptionId for fast lookups.
model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  stripePriceId        String
  plan                 Plan
  status               SubscriptionStatus
  // Window the *current* invoice covers. Used by the renewal cron to
  // know whether credits have already been refilled this cycle.
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Persistent log of every successful payment / refund. Used for the
// admin billing dashboard and for receipts.
model Payment {
  id                    String        @id @default(cuid())
  userId                String
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique
  stripeChargeId        String?       @unique
  amount                Int           // in smallest currency unit (cents)
  currency              String        @default("usd")
  status                PaymentStatus
  description           String?
  // What this payment bought — subscription cycle, credit pack, etc.
  type                  PaymentType
  metadata              Json?
  createdAt             DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

enum PaymentType {
  SUBSCRIPTION   // monthly plan charge
  CREDIT_PACK    // one-off credit purchase
  AGENT          // agent subscription
  REFUND
  OTHER
}

// In-app notification — delivered to the user inbox / bell dropdown.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  // Optional link the bell item should navigate to when clicked.
  href      String?
  // Free-form context (e.g. generationId, paymentId, …)
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationKind {
  GENERATION_DONE
  GENERATION_FAILED
  CREDITS_LOW
  CREDITS_REFILLED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFERRAL_BONUS
  PLAN_RENEWED
  PLAN_CANCELLED
  ANNOUNCEMENT
}

// Append-only structured audit trail of admin / sensitive actions.
// Distinct from CreditTransaction (financial) and Notification (user-facing).
model AuditLog {
  id        String         @id @default(cuid())
  // Who performed the action. Null = system / cron.
  actorId   String?
  // What kind of action (BAN_USER, PROMOTE_ADMIN, REFUND_GEN, …).
  action    String
  // Optional reference to the entity being acted on.
  targetId  String?
  targetKind String?       // "user" | "generation" | "subscription" | …
  // Original IP (best-effort) + user-agent for forensics.
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetKind, targetId])
}

// Tracks who invited whom + the bonus that was awarded.
model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  refereeId      String   @unique
  // Snapshot of the code used so changing the code later does not break
  // analytics on past referrals.
  codeUsed       String
  // Credits granted to each side (denormalised for clear reporting).
  referrerCredits Int     @default(0)
  refereeCredits  Int     @default(0)
  createdAt      DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee",  fields: [refereeId],  references: [id], onDelete: Cascade)

  @@index([referrerId])
}


// ════════════════════════════════════════════════════════════════════
// SOUL 2.0 — user-created moodboards and Soul ID characters.
// ════════════════════════════════════════════════════════════════════
// We don't fine-tune an actual model on the user's photos (no infra
// for that yet) — we store the references and pass them at generation
// time as `images_list` to the underlying image model. From the user's
// perspective the experience is the same: "build my moodboard" → see
// it in a list → use it on future generations.

// A user-built moodboard. Hard minimum is 5 reference images per the
// Higgsfield UX; we don't enforce a max but the picker recommends
// 20–30 for cohesion.
model SoulMoodboard {
  id          String   @id @default(cuid())
  userId      String
  name        String                          // "My Y2K vibes", "Brand book Q1"
  description String?                         // optional caption
  // Full URLs of the user's reference images stored on muapi.
  imageUrls   String[]
  // The synthesized prompt fragment we extract from the references at
  // creation time (e.g. via a Vision LLM). Falls back to a generic
  // descriptor if extraction fails.
  descriptor  String?
  thumbnail   String?                         // first image, used in the picker card
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A "Soul ID" — a saved character the user wants to keep consistent
// across generations. Higgsfield's flow asks for ≥20 photos from
// multiple angles; we store them all and pick a smart subset (3–5)
// to pass as references on each generation.
model SoulCharacter {
  id          String   @id @default(cuid())
  userId      String
  name        String                          // "Ahmed (me)", "Brand model Sarah"
  // Which Soul model this character was trained against — "soul" or
  // "soul-cinema" — so we can filter the picker UI to its parent tool.
  variant     String   @default("soul")
  // Up to ~30 reference photos. The first one is also the avatar.
  imageUrls   String[]
  thumbnail   String?
  // Free-form note appended to prompts when this character is active
  // (e.g. "the same young man with curly black hair from the
  // reference"). Auto-generated from the photos when possible.
  hintText    String?
  // Whether training has finished. For real fal.ai-trained LoRAs this
  // flips when the queue job returns COMPLETED. For legacy rows that
  // pre-date the fal.ai integration, it's true immediately.
  trained     Boolean  @default(false)
  // ── fal.ai Flux LoRA training metadata ──────────────────────────
  // request_id from POST /fal-ai/flux-lora-fast-training. We persist
  // it so users can navigate away during the ~5min training window
  // and we can still poll for completion.
  trainingId  String?
  // Mirrors fal's FalStatus enum: "IN_QUEUE" | "IN_PROGRESS" |
  //   "COMPLETED" | "ERROR". Null = pre-fal-ai legacy row.
  trainingStatus String?
  // The trained LoRA artifact URL (diffusers_lora_file.url). When
  // present, Soul ID-aware tools should route through fal-ai/flux-lora
  // inference with this LoRA loaded instead of the older "pass refs as
  // images_list" hack.
  loraUrl     String?
  // Trigger token to invoke this identity in flux-lora prompts (e.g.
  // "TOK"). Defaults to "TOK" matching fal-ai's default.
  triggerWord String?
  // When training fails, fal's error message lands here so the UI
  // can show it instead of a generic "failed".
  trainingError String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, variant])
  @@index([trainingId])
}

// ════════════════════════════════════════════════════════════════
// MARKETING — saved products + reusable ad references
// ════════════════════════════════════════════════════════════════
// `Product` rows back the Marketing Studio's WebProducts library so
// the user doesn't re-paste the same URL or re-upload the same image
// each session. `AdReference` rows are reusable inspiration videos
// (uploads or picks from previous jobs).

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  url         String?                          // landing-page URL (optional)
  imageUrl    String                           // primary image / icon
  screenshots String[] @default([])            // up to ~10 thumbnails (App Store / web carousel)
  source      String   @default("manual")      // "manual" | "url-fetch" | "app-store"
  category    String?                          // free text — UI uses this for filter chips
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdReference {
  id          String   @id @default(cuid())
  userId      String
  name        String
  mediaUrl    String                          // image or video URL
  mediaType   String   @default("video")      // "video" | "image"
  thumbnail   String?
  source      String   @default("upload")    // "upload" | "previous-job" | "library"
  generationId String?                       // when source == previous-job
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ════════════════════════════════════════════════════════════════
// TEAMS / COLLAB (shared workspaces)
// ════════════════════════════════════════════════════════════════
// A user can belong to many teams. Each team has its own pool of
// shared Spaces, Soul IDs, Moodboards, Canvases. Billing stays at
// the user level for now (team-level billing comes later).

model Team {
  id          String       @id @default(cuid())
  name        String
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  invites     TeamInvite[]

  owner User @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(MEMBER)
  token     String   @unique
  sentAt    DateTime @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, sentAt])
  @@index([email])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

// ════════════════════════════════════════════════════════════════
// API KEYS (workspace-scoped auth for MCP / CLI / SDKs)
// ════════════════════════════════════════════════════════════════
// Each row is a personal access token a user generates from
// /settings/api-keys. The plaintext key is shown once at creation;
// we persist only an SHA-256 hash so a DB leak doesn't expose them.
// `keyPrefix` (first 8 chars) is stored separately to display "yk_…"
// in the management UI.

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String                          // user-chosen label
  keyHash     String   @unique                // SHA-256 hex
  keyPrefix   String                          // e.g. "yk_AbCd"
  lastUsedAt  DateTime?
  scopes      String[]  @default(["read","write"])
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ════════════════════════════════════════════════════════════════
// CUSTOM VOICES (ElevenLabs voice-cloning flow)
// ════════════════════════════════════════════════════════════════
// Each row is a successful clone — we persist the ElevenLabs
// voice_id alongside our own user_id so the TTS / Lipsync /
// Voice-Change pickers can group "your custom voices" separately
// from the public catalogue.

model UserVoice {
  id          String   @id @default(cuid())
  userId      String
  voiceId     String                          // ElevenLabs voice_id
  name        String
  description String?
  sampleUrl   String?                         // source sample (read-only)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voiceId])
  @@index([userId, createdAt])
}

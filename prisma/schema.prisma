// Yilow.ai Database Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════
// AUTH (NextAuth v5 + Credentials)
// ════════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?   // bcrypt — null for OAuth-only users

  // Access control
  role           UserRole  @default(USER)
  isBanned       Boolean   @default(false)
  bannedReason   String?
  bannedAt       DateTime?

  // Plan & credits
  plan           Plan      @default(FREE)
  creditsBalance Int       @default(100)   // seed bonus
  creditsLimit   Int       @default(100)   // plan monthly allowance
  planRenewsAt   DateTime?

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  generations        Generation[]
  chatConversations  ChatConversation[]
  spaces             Space[]
  agentSubscriptions AgentSubscription[]
  creditTransactions CreditTransaction[]
  subscriptions      Subscription[]
  payments           Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]    @relation("ActorLogs")
  referralsGiven     Referral[]    @relation("Referrer")
  referralsReceived  Referral[]    @relation("Referee")
  referralCode       String?       @unique
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  USER
  ADMIN         // can manage users, view analytics
  SUPER_ADMIN   // everything ADMIN can do + grant/revoke admin roles
}

// OAuth linked accounts (Google/GitHub)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ════════════════════════════════════════════════════════════════
// CREDITS
// ════════════════════════════════════════════════════════════════

model CreditTransaction {
  id        String          @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Int             // negative for deductions, positive for purchases/bonuses
  balanceAfter Int
  reason    String?         // tool id, purchase id, etc.
  metadata  Json?           // { toolId, toolName, generationId, stripePaymentId }
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum TransactionType {
  DEDUCTION       // tool usage
  PURCHASE        // bought credits pack
  SUBSCRIPTION    // monthly plan renewal bonus
  BONUS           // signup gift, referral
  REFUND          // failed generation
  ADJUSTMENT      // admin adjustment
}

// ════════════════════════════════════════════════════════════════
// GENERATIONS (tool outputs history)
// ════════════════════════════════════════════════════════════════

model Generation {
  id          String            @id @default(cuid())
  userId      String
  toolId      String            // matches src/lib/data/tools.ts id
  toolName    String            // cached for display
  category    String            // "image" | "video" | "audio"
  status      GenerationStatus  @default(PENDING)
  creditsUsed Int

  inputs      Json              // form inputs object
  outputs     Json?             // MuAPI response (urls, text, etc.)
  errorMessage String?

  muapiJobId  String?           // for polling long-running jobs
  durationMs  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([toolId])
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ════════════════════════════════════════════════════════════════
// CHAT
// ════════════════════════════════════════════════════════════════

model ChatConversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("محادثة جديدة")
  model     String    // "claude-3-5-sonnet" | "gpt-4o" | "gemini-1.5-pro" | "llama-3"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String           @db.Text
  attachments    Json?            // array of file refs
  metadata       Json?            // tokens, model-specific, etc.
  createdAt      DateTime         @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// ════════════════════════════════════════════════════════════════
// SPACES (collaboration canvas)
// ════════════════════════════════════════════════════════════════

model Space {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("مساحة جديدة")
  description String?
  thumbnail   String?  // auto-generated preview

  // @xyflow/react state
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  viewport    Json?    // { x, y, zoom }

  // sharing
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastOpenedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ════════════════════════════════════════════════════════════════
// AGENT SUBSCRIPTIONS (marketplace)
// ════════════════════════════════════════════════════════════════

model AgentSubscription {
  id              String              @id @default(cuid())
  userId          String
  agentId         String              // matches src/lib/data/agents.ts id
  agentName       String              // cached
  monthlyPriceUsd Decimal             @db.Decimal(10, 2)
  status          SubscriptionStatus  @default(ACTIVE)

  stripeSubscriptionId String? @unique

  startedAt   DateTime  @default(now())
  renewalDate DateTime?
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

// ════════════════════════════════════════════════════════════════
// BILLING — Stripe-backed subscriptions, one-off payments, credit packs
// ════════════════════════════════════════════════════════════════

// One row per Stripe subscription. The "current" subscription for a user
// is also denormalised on User.stripeSubscriptionId for fast lookups.
model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  stripePriceId        String
  plan                 Plan
  status               SubscriptionStatus
  // Window the *current* invoice covers. Used by the renewal cron to
  // know whether credits have already been refilled this cycle.
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Persistent log of every successful payment / refund. Used for the
// admin billing dashboard and for receipts.
model Payment {
  id                    String        @id @default(cuid())
  userId                String
  stripePaymentIntentId String?       @unique
  stripeInvoiceId       String?       @unique
  stripeChargeId        String?       @unique
  amount                Int           // in smallest currency unit (cents)
  currency              String        @default("usd")
  status                PaymentStatus
  description           String?
  // What this payment bought — subscription cycle, credit pack, etc.
  type                  PaymentType
  metadata              Json?
  createdAt             DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

enum PaymentType {
  SUBSCRIPTION   // monthly plan charge
  CREDIT_PACK    // one-off credit purchase
  AGENT          // agent subscription
  REFUND
  OTHER
}

// In-app notification — delivered to the user inbox / bell dropdown.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  // Optional link the bell item should navigate to when clicked.
  href      String?
  // Free-form context (e.g. generationId, paymentId, …)
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationKind {
  GENERATION_DONE
  GENERATION_FAILED
  CREDITS_LOW
  CREDITS_REFILLED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFERRAL_BONUS
  PLAN_RENEWED
  PLAN_CANCELLED
  ANNOUNCEMENT
}

// Append-only structured audit trail of admin / sensitive actions.
// Distinct from CreditTransaction (financial) and Notification (user-facing).
model AuditLog {
  id        String         @id @default(cuid())
  // Who performed the action. Null = system / cron.
  actorId   String?
  // What kind of action (BAN_USER, PROMOTE_ADMIN, REFUND_GEN, …).
  action    String
  // Optional reference to the entity being acted on.
  targetId  String?
  targetKind String?       // "user" | "generation" | "subscription" | …
  // Original IP (best-effort) + user-agent for forensics.
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetKind, targetId])
}

// Tracks who invited whom + the bonus that was awarded.
model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  refereeId      String   @unique
  // Snapshot of the code used so changing the code later does not break
  // analytics on past referrals.
  codeUsed       String
  // Credits granted to each side (denormalised for clear reporting).
  referrerCredits Int     @default(0)
  refereeCredits  Int     @default(0)
  createdAt      DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee",  fields: [refereeId],  references: [id], onDelete: Cascade)

  @@index([referrerId])
}


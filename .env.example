# ════════════════════════════════════════════════════════════════
# DATABASE — PostgreSQL connection string
# ════════════════════════════════════════════════════════════════
# For local dev run:  npx prisma dev
# Then copy the DATABASE_URL it prints here.
# For production, use your managed Postgres (Supabase, Neon, RDS...).
DATABASE_URL="postgres://user:pass@host:5432/yilow?sslmode=require"
SHADOW_DATABASE_URL="postgres://user:pass@host:5432/yilow_shadow?sslmode=require"

# ════════════════════════════════════════════════════════════════
# MuAPI — AI tools proxy
# ════════════════════════════════════════════════════════════════
MU_API_KEY="your-muapi-key"

# ════════════════════════════════════════════════════════════════
# NEXTAUTH v5
# ════════════════════════════════════════════════════════════════
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# OAuth (optional — only enabled when both ID + SECRET are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ════════════════════════════════════════════════════════════════
# AI CHAT — Vercel AI Gateway key
# ════════════════════════════════════════════════════════════════
# One key → routes to Anthropic/OpenAI/Google/etc via @ai-sdk/gateway.
# Without this the /api/chat endpoint returns 503.
AI_GATEWAY_API_KEY=""

# ════════════════════════════════════════════════════════════════
# STRIPE — Subscriptions + credit packs
# ════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Plan price IDs (create these in Stripe Dashboard → Products)
STRIPE_PRICE_STARTER=""        # $15
STRIPE_PRICE_BASIC=""          # $9   (legacy)
STRIPE_PRICE_LITE=""           # $19
STRIPE_PRICE_PRO=""            # $29
STRIPE_PRICE_PLUS=""           # $49
STRIPE_PRICE_CREATOR=""        # $79
STRIPE_PRICE_ULTIMATE=""       # $99
STRIPE_PRICE_ULTRA=""          # $129
STRIPE_PRICE_TEAM=""           # $149
STRIPE_PRICE_ENTERPRISE=""     # $299

# Credit pack price IDs (one-off purchases)
STRIPE_PRICE_PACK_500=""
STRIPE_PRICE_PACK_1500=""
STRIPE_PRICE_PACK_3000=""
STRIPE_PRICE_PACK_5000=""
STRIPE_PRICE_PACK_10000=""
STRIPE_PRICE_PACK_15000=""
STRIPE_PRICE_PACK_30000=""
STRIPE_PRICE_PACK_50000=""
STRIPE_PRICE_PACK_100000=""

# ════════════════════════════════════════════════════════════════
# OpenRouter — LLM gateway (Claude / GPT / Gemini etc.)
# ════════════════════════════════════════════════════════════════
# Required for: Assist chatbot, Marketing enhancer, Product Photoshoot
# Claude prompts, Marketplace Cards Claude prompts, Virality Predictor,
# Storyboard Extractor, Breakdown, Similarity Score.
OPENROUTER_API_KEY=""

# ════════════════════════════════════════════════════════════════
# fal.ai — Flux LoRA training (real Soul ID character training)
# ════════════════════════════════════════════════════════════════
FAL_KEY=your_fal_key_id:your_fal_key_secret

# ════════════════════════════════════════════════════════════════
# ElevenLabs — TTS / Lipsync / Voice Cloning
# ════════════════════════════════════════════════════════════════
ELEVENLABS_API_KEY=""

# ════════════════════════════════════════════════════════════════
# Cron + Webhook signing
# ════════════════════════════════════════════════════════════════
# CRON_SECRET protects /api/cron/* endpoints from non-Vercel callers.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Used by /api/audio/dubbing and any outbound webhook we sign.
# Rotate by adding WEBHOOK_SECRET_OLD for one deploy cycle.
WEBHOOK_SECRET=""
WEBHOOK_SECRET_OLD=""

# ════════════════════════════════════════════════════════════════
# Resend — transactional emails
# ════════════════════════════════════════════════════════════════
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Yilow.ai <noreply@yilow.ai>"
